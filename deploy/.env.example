# 复制为 .env 后填写。.env 里有密码，不要提交、不要外发。
#
# 生成随机串（服务器上直接跑）：
#   openssl rand -hex 32

# ===== 必填 =====
# 应用账号密码（MySQL 首次初始化时写入，之后改这里不会改库里已有的密码）
DB_PASS=
# root 密码，仅在容器内使用，不对外
MYSQL_ROOT_PASSWORD=
# JWT 签名密钥，必须换成本机随机串
JWT_SECRET=

# ===== 一般不用改 =====
DB_NAME=workstation_parents
DB_USER=parents_app
JWT_EXPIRES=7d
